# En producción, indica la ruta absoluta del archivo SQLite en el volumen persistente.
ORBITA_DB_PATH=
# Turso en Vercel. Define estas variables solo en el servidor.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# En producción, indica el origen HTTPS público exacto, sin barra final.
APP_ORIGIN=
# Solo para inicializar el primer administrador en producción. Mínimo 32 caracteres aleatorios.
SETUP_TOKEN=
# Web Push. Las claves VAPID se mantienen estables entre despliegues.
PUSH_PUBLIC_KEY=
PUSH_PRIVATE_KEY=
PUSH_SUBJECT=
# El servidor Node usa 127.0.0.1:8080 por defecto. Docker escucha en todas las interfaces.
# HOST=127.0.0.1
# PORT=8080
